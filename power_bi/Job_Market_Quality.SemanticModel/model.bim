      {
        "name": "ReportMeasures",
        "columns": [
          {
            "name": "Placeholder",
            "dataType": "int64",
            "isHidden": true,
            "lineageTag": "e186705a-61ea-48c4-ac55-d631d85a5fb1",
            "sourceColumn": "Placeholder"
          }
        ],
        "lineageTag": "1ec384cd-46a3-4bf0-9e5c-8bb806c9f2cd",
        "measures": [
          {
            "name": "Total Postings",
            "displayFolder": "Clarity measures",
            "expression": "COUNTROWS ( fact_job_posting )",
            "formatString": "#,0",
            "lineageTag": "ae16467e-5b9f-47ac-afe6-289f62371583"
          },
          {
            "name": "Distinct Jobs",
            "displayFolder": "Clarity measures",
            "expression": "DISTINCTCOUNT ( fact_job_posting[job_key] )",
            "formatString": "#,0",
            "lineageTag": "ae900b2e-e633-4ad5-a132-970b2ac8a3c1"
          },
          {
            "name": "Average JD Quality",
            "displayFolder": "Clarity measures",
            "expression": [
              "CALCULATE (",
              "    AVERAGE ( fact_job_quality[jd_quality_score] ),",
              "    KEEPFILTERS ( TREATAS ( VALUES ( fact_job_posting[job_key] ), fact_job_quality[job_key] ) )",
              ")"
            ],
            "formatString": "0.00",
            "lineageTag": "f63790f7-2cbd-4330-b540-6fd3a4f6d262"
          },
          {
            "name": "Salary Transparency %",
            "displayFolder": "Clarity measures",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( [Total Postings], KEEPFILTERS ( fact_job_posting[salary_numeric_present] = TRUE () ) ),",
              "    [Total Postings]",
              ")"
            ],
            "formatString": "0.0%",
            "lineageTag": "9126b197-81cc-4b5b-9999-ed038eba72f1"
          },
          {
            "name": "Entry-Level Jobs",
            "displayFolder": "Clarity measures",
            "expression": "CALCULATE ( [Distinct Jobs], KEEPFILTERS ( fact_job_posting[seniority_title] = \"entry\" ) )",
            "formatString": "#,0",
            "lineageTag": "192027eb-ba63-42f4-a77c-b6f5fe5d9103"
          },
          {
            "name": "Entry Jobs Requiring 2+ Years",
            "displayFolder": "Clarity measures",
            "expression": [
              "CALCULATE (",
              "    [Distinct Jobs],",
              "    KEEPFILTERS ( fact_job_posting[seniority_title] = \"entry\" ),",
              "    KEEPFILTERS ( fact_job_posting[experience_min_years] >= 2 )",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "24c86b8c-b462-4311-adf5-a3258e3e553a"
          },
          {
            "name": "Entry 2+ Years %",
            "displayFolder": "Clarity measures",
            "expression": "DIVIDE ( [Entry Jobs Requiring 2+ Years], [Entry-Level Jobs] )",
            "formatString": "0.0%",
            "lineageTag": "a42795d0-ef20-41b4-b7b7-caf72cd6e42e"
          },
          {
            "name": "Scored Jobs",
            "displayFolder": "Clarity measures",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( fact_job_quality[job_key] ),",
              "    KEEPFILTERS ( TREATAS ( VALUES ( fact_job_posting[job_key] ), fact_job_quality[job_key] ) )",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "28a93bde-d4ee-4173-9006-fae363ef8452"
          },
          {
            "name": "Quality Review Jobs",
            "displayFolder": "Clarity measures",
            "expression": [
              "CALCULATE (",
              "    [Scored Jobs],",
              "    KEEPFILTERS ( fact_job_quality[quality_band] IN { \"Review Recommended\", \"Multiple Quality Concerns\" } )",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "2a1d6489-da55-4167-b2b1-4568414a2af9"
          },
          {
            "name": "Quality Band",
            "displayFolder": "Clarity measures",
            "expression": [
              "CALCULATE (",
              "    SELECTEDVALUE ( fact_job_quality[quality_band] ),",
              "    KEEPFILTERS ( TREATAS ( VALUES ( fact_job_posting[job_key] ), fact_job_quality[job_key] ) )",
              ")"
            ],
            "lineageTag": "cf64a199-d9fc-4e4b-8ca8-e13ab3f21dc3"
          },
          {
            "name": "Visible Flags",
            "displayFolder": "Clarity measures",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( fact_job_flag ),",
              "    KEEPFILTERS ( TREATAS ( VALUES ( fact_job_posting[job_key] ), fact_job_flag[job_key] ) )",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "f3d22474-d3a2-4ed0-b3b6-0316135b8ac7"
          },
          {
            "name": "Jobs with Entry Review Flags",
            "displayFolder": "Clarity measures",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( fact_job_flag[job_key] ),",
              "    KEEPFILTERS ( fact_job_flag[rule_code] = \"ENTRY_ROLE_REQUIRES_2PLUS_YEARS\" ),",
              "    KEEPFILTERS ( TREATAS ( VALUES ( fact_job_posting[job_key] ), fact_job_flag[job_key] ) )",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "945c88b5-3eee-4a9c-bd5f-9f60b952717c"
          },
          {
            "name": "Repost Events",
            "displayFolder": "Clarity measures",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( fact_repost_event ),",
              "    KEEPFILTERS ( TREATAS ( VALUES ( fact_job_posting[source_job_id] ), fact_repost_event[current_source_job_id] ) )",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "3a0f0dff-2ca5-4e42-8c6c-39abaf79d14b"
          },
          {
            "name": "Jobs with Skill",
            "displayFolder": "Clarity measures",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( bridge_job_skill[job_key] ),",
              "    KEEPFILTERS ( TREATAS ( VALUES ( fact_job_posting[job_key] ), bridge_job_skill[job_key] ) )",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "5e1d0569-7460-4258-8a42-1db832a42fd5"
          },
          {
            "name": "Missing Pay Postings",
            "displayFolder": "Clarity measures",
            "expression": "CALCULATE([Total Postings], KEEPFILTERS(fact_job_posting[salary_numeric_present] = FALSE()))",
            "formatString": "#,0",
            "lineageTag": "aecc6ff2-1a74-4b16-98c5-a43bbd25d0a3"
          },
          {
            "name": "Experience Coverage %",
            "displayFolder": "Clarity measures",
            "expression": "DIVIDE(CALCULATE([Total Postings], KEEPFILTERS(fact_job_posting[experience_numeric_present] = TRUE())), [Total Postings])",
            "formatString": "0.0%",
            "lineageTag": "f8d83a48-76db-408e-87bf-efd43de96c0e"
          },
          {
            "name": "Remote Permission %",
            "displayFolder": "Clarity measures",
            "expression": "DIVIDE(CALCULATE([Total Postings], KEEPFILTERS(fact_job_posting[workplace_type] = \"remote\")), [Total Postings])",
            "formatString": "0.0%",
            "lineageTag": "b4dff9eb-d15e-403e-be17-314614cafe42"
          },
          {
            "name": "Repeat Share %",
            "displayFolder": "Clarity measures",
            "expression": "DIVIDE([Repost Events], [Total Postings])",
            "formatString": "0.0%",
            "lineageTag": "5546ab49-b738-4bc5-9590-e6dd65e2cf77"
          },
          {
            "name": "Review Share %",
            "displayFolder": "Clarity measures",
            "expression": "DIVIDE([Quality Review Jobs], [Distinct Jobs])",
            "formatString": "0.0%",
            "lineageTag": "772990e5-a4bd-487b-b518-67722e0565c7"
          },
          {
            "name": "One Job Selected",
            "displayFolder": "Report controls",
            "expression": "IF(COUNTROWS(ALLSELECTED(dim_job[job_key])) = 1, 1, 0)",
            "formatString": "0",
            "lineageTag": "5cffff26-3c85-4d62-bc04-63c88cc09df2"
          },
          {
            "name": "Selected Title",
            "displayFolder": "Report controls",
            "expression": "IF([One Job Selected] = 1, SELECTEDVALUE(dim_job[title_normalized]), \"Choose a job ID\")",
            "lineageTag": "9ae47747-957f-4f2b-a99c-4b02569b5763"
          },
          {
            "name": "Top 10 Repeating Companies",
            "displayFolder": "Report controls",
            "expression": [
              "VAR ThisCompany = SELECTEDVALUE(dim_company[company_key])",
              "VAR TopCompanies = TOPN(10, ALLSELECTED(dim_company), [Repost Events], DESC, dim_company[company_key], ASC)",
              "RETURN IF([Repost Events] > 0 && CONTAINS(TopCompanies, dim_company[company_key], ThisCompany), 1, 0)"
            ],
            "formatString": "0",
            "lineageTag": "849c79e5-efcb-4ec3-8877-d7f5bbaa7d0b"
          },
          {
            "name": "Job Description",
            "displayFolder": "Report controls",
            "expression": "IF([One Job Selected] = 1, CONCATENATEX(TOPN(1, fact_job_posting, fact_job_posting[published_date_key], DESC, fact_job_posting[source_job_id], DESC), LEFT(fact_job_posting[description_clean], 6000), \"\"))",
            "lineageTag": "bbe47c68-e1e9-4823-b476-7a5c81ef0035"
          },
          {
            "name": "Salary Numeric Rows",
            "displayFolder": "Clarity measures",
            "expression": "CALCULATE([Total Postings], KEEPFILTERS(fact_job_posting[salary_numeric_present] = TRUE()))",
            "formatString": "#,0",
            "lineageTag": "0bf299e2-7b21-4a19-b202-ffe7b9b95a35"
          },
          {
            "name": "Mapped Role Filter",
            "displayFolder": "Clarity measures",
            "expression": "IF(SELECTEDVALUE(dim_role[canonical_role_name]) <> \"Unclassified\", 1, 0)",
            "formatString": "0",
            "lineageTag": "eac8c573-1969-4d1d-8cee-1430c3bcc92c"
          }
        ],
        "partitions": [
          {
            "name": "ReportMeasures",
            "mode": "import",
            "source": {
              "expression": "#table(type table [Placeholder=Int64.Type], {{1}})",
              "type": "m"
            }
          }
        ]
      }
    ]
  }
